{
  "name": "ascii-ify",
  "version": "0.0.2",
  "type": "module",
  "description": "ASCII-ify any canvas. Layered compositing, procedural patterns, optional control panel.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlhg/ascii-ify.git"
  },
  "homepage": "https://github.com/dlhg/ascii-ify#readme",
  "bugs": {
    "url": "https://github.com/dlhg/ascii-ify/issues"
  },
  "main": "dist/ascii-ify.cjs",
  "module": "dist/ascii-ify.js",
  "exports": {
    ".": {
      "import": "./dist/ascii-ify.js",
      "require": "./dist/ascii-ify.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:plugin-web": "vite build --config plugin/vite.config.js",
    "build:plugin": "node plugin/build.mjs",
    "install:plugin": "node plugin/install.mjs",
    "test:plugin": "node --test plugin/tests/*.test.mjs",
    "preview": "vite preview",
    "test:unit": "node --test tests/unit/",
    "test:perf": "node tests/perf/compare.mjs",
    "test:perf:current": "playwright test tests/perf/perf.spec.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ascii",
    "canvas",
    "visualization",
    "ascii-art",
    "creative-coding"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "vite": "^6.0.0"
  }
}
